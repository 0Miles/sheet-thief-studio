# Copy to deploy/.env and fill in (docs/DEPLOYMENT.md). No value here is a real secret.

# ---- The mode: keep one of the two lines ------------------------------------------------------
# Standalone, on its own domain behind nginx (nginx/studio.conf):
COMPOSE_FILE=compose.yaml:compose.standalone.yaml
# A plugin of the karyl-chan bot, on its karyl-chan-net:
#COMPOSE_FILE=compose.yaml:compose.plugin.yaml

# ---- Both modes -------------------------------------------------------------------------------
# Postgres' password, which DATABASE_URL is made of: letters and digits only, since it goes into a
# URL as it is. For example `openssl rand -hex 32`.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Where the pages are served from, without a trailing slash. Requests that change something must
# carry this Origin. Standalone: this site's own origin. Plugin: the bot's public origin.
PUBLIC_ORIGIN=https://studio.example.com
# Optional: these default to the services of compose.yaml.
#DATABASE_URL=postgres://studio:<password>@postgres:5432/studio
#REDIS_URL=redis://redis:6379/0
#RECOGNIZER_URL=http://recognizer:8000
# The tag of the images Compose builds; a release's version keeps the previous image to go back to.
#STUDIO_IMAGE_TAG=latest
# Answers carry Strict-Transport-Security when 1. Defaults: 1 standalone, 0 plugin.
#HSTS=1

# ---- Standalone only ----------------------------------------------------------------------------
# The port on this host's loopback that nginx proxies to (nginx/studio.conf's upstream).
#STUDIO_PORT=8031
# The `edge` network, between nginx and the server; change both when the subnet is taken here.
#EDGE_SUBNET=172.31.73.0/24
#EDGE_GATEWAY=172.31.73.1
# Defaults to EDGE_GATEWAY, where nginx's connections come from. Set it when nginx runs elsewhere.
#TRUSTED_PROXIES=172.31.73.1

# ---- Plugin only --------------------------------------------------------------------------------
# The setup secret the bot's admin issued at /admin/plugins for the key `sheet-thief-studio`.
KARYL_PLUGIN_SETUP_SECRET=replace-with-the-setup-secret-of-admin-plugins
# The bot's proxy: its address on karyl-chan-net or the network's subnet, from
#   docker network inspect karyl-chan-net --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#TRUSTED_PROXIES=172.18.0.0/16
# Defaults: the bot's container name, and the alias compose.plugin.yaml gives this server.
#BOT_URL=http://karyl-chan:3000
#PLUGIN_URL=http://karyl-plugin-sheet-thief-studio:8031
